# PostgreSQL connection string (used by Drizzle and docker-compose).
DATABASE_URL=postgresql://spec2test:spec2test@localhost:5432/spec2test

# Which model provider to use. The app reads this instead of hardcoding a
# provider so OpenAI and Anthropic can be swapped without code changes.
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-sonnet-5

# Only the key matching MODEL_PROVIDER needs a real value.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
