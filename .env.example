# PostgreSQL connection string for the app (and drizzle-kit locally).
# Locally: the docker-compose database. In production: Neon's *pooled*
# connection string (host contains "-pooler"), pasted as-is; the app drops
# channel_binding and turns off prepared statements for it (see
# src/lib/db/connection.ts).
DATABASE_URL=postgresql://spec2test:spec2test@localhost:5432/spec2test

# Production only, in a separate .env.production.local (git-ignored), read
# by `pnpm db:migrate:prod` on your laptop: Neon's *direct* connection
# string (no "-pooler"), because migrations need a real session.
# DATABASE_URL_UNPOOLED=

# Which provider/model to use for chat. The app reads this instead of
# hardcoding a provider so openai, anthropic, or google can be swapped in
# without code changes (see src/lib/ai/providers.ts).
# gemini-flash-lite-latest over gemini-flash-latest: the plain "latest"
# alias currently resolves to a flagship model with a 20-requests/day
# free-tier cap, which this pipeline's ~12 calls per run exhausts almost
# immediately. The lite tier's free quota is far more generous. (We also
# tried gemini-2.5-flash directly, but Google has retired it for new API
# keys as of this writing.)
# MODEL_PROVIDER=mock swaps in a deterministic, rule-based stand-in (see
# src/lib/ai/mock-model.ts) for e2e tests and offline demos: no API key,
# same output every time. MOCK_MODEL_DELAY_MS sets its per-call pause.
MODEL_PROVIDER=google
MODEL_NAME=gemini-flash-lite-latest
MOCK_MODEL_DELAY_MS=500

# Which provider/model to use for embeddings. Anthropic has no embeddings
# API, so this is configured separately from the chat provider above.
# EMBEDDING_DIMENSIONS must match the `embedding` column width in
# src/lib/db/schema.ts (chunks table) — they're both 768 by default.
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Max texts embedded per minute. Gemini's free tier allows 100/min and
# counts every text in a batch separately; 80 leaves headroom.
EMBEDDING_RPM_LIMIT=80

# Optional voice output (ElevenLabs text-to-speech). Leave the key empty to
# turn voice off: the Listen buttons disappear and /api/voice returns 503.
# Voice and model fall back to the defaults in src/lib/voice/config.ts.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_v4

# Only the key matching the provider(s) selected above needs a real value.
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Public URL of the web app. The MCP server links to the review screen
# with it (<APP_URL>/?run=<id>) when a run is waiting for human review.
APP_URL=http://localhost:3000

# Per-client and global request limits on uploads, agent runs, chat, and
# voice, so the free API quotas can't be used up by accident (see
# src/lib/services/rate-limits.ts). Set to "off" only for test servers.
RATE_LIMITS=on

# Demo mode (src/lib/access.ts). When ACCESS_CODE is set, visitors can
# browse every existing run, export, and Insights, but uploading, running
# the agents, reviewing, chat, and voice need this code. Leave it empty
# locally: nothing is gated. In production, a long random value set only in
# the host's dashboard, never committed.
ACCESS_CODE=
# Public text completing "To get a code, ...", e.g. "email me at
# name@example.com". Not a secret. Optional.
ACCESS_CODE_CONTACT=

# Tests only. The MCP test suite's database; defaults to spec2test_mcp on
# the docker-compose server (see vitest.mcp.config.mts).
# MCP_TEST_DATABASE_URL=
