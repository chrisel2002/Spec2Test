# PostgreSQL connection string (used by Drizzle and docker-compose).
DATABASE_URL=postgresql://spec2test:spec2test@localhost:5432/spec2test

# Which provider/model to use for chat. The app reads this instead of
# hardcoding a provider so openai, anthropic, or google can be swapped in
# without code changes (see src/lib/ai/providers.ts).
MODEL_PROVIDER=google
MODEL_NAME=gemini-flash-latest

# Which provider/model to use for embeddings. Anthropic has no embeddings
# API, so this is configured separately from the chat provider above.
# EMBEDDING_DIMENSIONS must match the `embedding` column width in
# src/lib/db/schema.ts (chunks table) — they're both 768 by default.
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Only the key matching the provider(s) selected above needs a real value.
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
