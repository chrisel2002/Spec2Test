{
  "name": "spec2test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "dotenv -e .env.local -- vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:mcp": "vitest run --config vitest.mcp.config.mts",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "tts:hello": "dotenv -e .env.local -- tsx scripts/tts-hello.ts",
    "mcp": "node --conditions=react-server --import tsx src/mcp/main.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/react": "^4.0.130",
    "@base-ui/react": "^1.8.0",
    "@elevenlabs/elevenlabs-js": "^2.72.0",
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.19",
    "@langchain/langgraph-checkpoint-postgres": "1.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ai": "^7.0.127",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1"
}
